# Turso database — create a free database at turso.tech and paste the values here.
# For local dev you can use TURSO_DATABASE_URL=file:local.db (no token needed).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required in production. Rotate this value out of band.
BOARD_PASSCODE=
# A separate random value of at least 32 characters used to sign access cookies.
SESSION_SECRET=

# Claude API key — required for triage.py to classify inbox items.
ANTHROPIC_API_KEY=

# Google Sheets credentials — only needed for the one-time migration script (scripts/migrate-from-sheets.js).
# Remove these once migration to Turso is complete.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
