# Google Sheet ID from the URL (never commit credentials).
GOOGLE_SHEET_ID=
# Entire service-account JSON, stored as one deployment secret.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Required in production. Rotate this value out of band.
BOARD_PASSCODE=
# A separate random value of at least 32 characters used to sign access cookies.
SESSION_SECRET=

# Local development only. Production builds intentionally fail without Sheets access.
ALLOW_SAMPLE_DATA=false
